# ==============================================================================
# job-fit — Configuración de Variables de Entorno
# Copia este archivo como `.env` y completa los valores.
# IMPORTANTE: nunca subas `.env` a un repositorio público (.gitignore lo excluye).
# ==============================================================================

# ------------------------------------------------------------------------------
# PROVEEDOR LLM — Elige UNA de las dos opciones y completa solo esa.
# El sistema detecta el proveedor automáticamente según el formato de la clave.
# ------------------------------------------------------------------------------

# OPCIÓN A: Google AI Studio (Gemini) — Gratis, recomendado para empezar.
# Obtén tu clave en: https://aistudio.google.com → "Get API key" → "Create API key"
# La clave empieza con "AIzaSy..." o "AQ...."
LLM_API_KEY=tu_api_key_de_google_ai_studio_aqui
LLM_MODEL=gemini-2.5-flash-lite

# OPCIÓN B: OpenRouter — Acceso a modelos de OpenAI, Anthropic, DeepSeek, etc.
# Obtén tu clave en: https://openrouter.ai → Dashboard → API Keys → Create Key
# La clave empieza con "sk-or-..."
# Modelos gratuitos recomendados: google/gemma-3-27b-it:free, deepseek/deepseek-r1:free
# Descomenta y completa SOLO si usas OpenRouter (y deja LLM_API_KEY vacío o comenta esa línea):
# LLM_API_KEY=sk-or-tu_api_key_de_openrouter_aqui
# LLM_MODEL=google/gemma-3-27b-it:free

# (Opcional) Proveedor explícito — solo necesario si el sistema no detecta bien el proveedor.
# Valores posibles: gemini | openrouter | openai | deepseek | groq | ollama
# LLM_PROVIDER=gemini

# (Opcional) Para Ollama local u otros endpoints compatibles con OpenAI:
# LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# NOTIFICACIONES — Discord (opcional)
# ------------------------------------------------------------------------------
# El sistema te envía un mensaje a Discord con el CV en PDF cuando detecta una
# oferta con buen match. Si no usas Discord, deja esta variable vacía o comenta.
# Cómo crear un webhook: Discord → canal → ⚙️ → Integraciones → Webhooks → Nuevo
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# BASE DE DATOS Y RUTAS (no es necesario modificar estos valores)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/db/job_fit.db
OUTPUT_PDF_DIR=./data/generated_cvs
TEMPLATES_DIR=./templates/cv

# ------------------------------------------------------------------------------
# CONTROL DE CUOTA LLM (ajusta según tu plan)
# ------------------------------------------------------------------------------
LLM_MAX_CALLS_PER_DAY=150
LLM_MAX_CALLS_PER_MINUTE=10
